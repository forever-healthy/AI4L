{
  "mcpServers": {
    "d-clinicaltrialsgov": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "MCP_TRANSPORT_TYPE=stdio",
        "-e",
        "MCP_LOG_LEVEL=info",
        "ghcr.io/cyanheads/clinicaltrialsgov-mcp-server:latest"
      ]
    },
    "d-pubmed": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network=host",
        "-e",
        "MCP_TRANSPORT_TYPE=stdio",
        "-e",
        "MCP_LOG_LEVEL=info",
        "--env-file",
        ".env",
        "ghcr.io/cyanheads/pubmed-mcp-server:latest"
      ]
    },
    "d-fetch": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/fetch",
        "--ignore-robots-txt",
        "--user-agent=Chrome/145.0.7632.160"
      ]
    },
    "d-browser": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--init",
        "--shm-size=2gb",
        "--cap-add=SYS_ADMIN",
        "-e",
        "HEADLESS=true",
        "mcr.microsoft.com/playwright/mcp:latest"
      ]
    },
    "d-proxy-1": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        ".env",
        "-e",
        "GROUPS=browser",
        "node:22-alpine",
        "sh",
        "-c",
        "API_TOKEN=$BRIGHTDATA_API_TOKEN exec npx -y @brightdata/mcp"
      ]
    }
  }
}
